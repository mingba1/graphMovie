DATABASE_URL=
TOOL_BACKEND=local
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graphmovie
OPENAI_API_KEY=
OPENAI_BASE_URL=
GRAPHMOVIE_USE_LLM=0
GRAPHMOVIE_DATA_DIR=

# API security (comma-separated). Empty disables auth for local/dev.
GRAPHMOVIE_API_KEYS=
GRAPHMOVIE_RATE_LIMIT_PER_MINUTE=60
GRAPHMOVIE_REQUEST_TIMEOUT_SEC=120

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_SOFT_TIME_LIMIT=120
CELERY_TIME_LIMIT=180
# Set to 1 for in-process tasks (tests / no Redis)
CELERY_TASK_ALWAYS_EAGER=0
